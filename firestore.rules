rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Captured test requests. The Worker writes here without logging in
    // (that's normal — it's just relaying whatever hit its public URL).
    // Only signed-in admins (see below) can read them.
    match /requests/{docId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Allow-list of dashboard users. Each document ID is an email address,
    // e.g. admins/revanth.abbati@dispatchtrack.com
    // Add more people later by creating more documents here — no redeploy
    // needed. Nobody can read or write this collection from outside; it's
    // only ever checked internally by isAdmin() below.
    match /admins/{email} {
      allow read, write: if false;
    }

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }
  }
}
