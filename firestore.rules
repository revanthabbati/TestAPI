rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can ADD a new test request (needed since the Worker writes
    // without logging in). Nobody can read, change, or delete from outside —
    // you view everything safely through the Firebase Console instead,
    // where you're logged in as the project owner.
    match /requests/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
